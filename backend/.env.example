# API Configuration
API_V1_STR="/api/v1"
PROJECT_NAME="HealthMitra 2.0"

# Security (replace both values before starting the app)
SECRET_KEY="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
ENCRYPTION_KEY="REPLACE_WITH_OUTPUT_FROM_FERNET_GENERATE_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALGORITHM="HS256"
CORS_ORIGINS='["http://localhost:3000"]'
# Generate SECRET_KEY with secrets.token_urlsafe(48).
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# MongoDB
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="healthmitra"

# APIs (optional; chatbot features use limited behavior without this key)
GROQ_API_KEY="your_groq_api_key_here"
