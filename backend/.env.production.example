# ============================================================
# HealthMitra 2.0 — Production Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to backend/.env.production
#   2. Replace ALL placeholder values with real secrets
#   3. NEVER commit this file to version control
# ============================================================

# --- App Mode ---
ENVIRONMENT=production

# --- Security (MANDATORY — generate unique values) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_HERE

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_OUTPUT

ACCESS_TOKEN_EXPIRE_MINUTES=15
ALGORITHM=HS256

# --- CORS (set to your actual production frontend domain) ---
CORS_ORIGINS=["https://your-domain.com"]

# --- MongoDB (authenticated connection) ---
# For self-hosted Docker:
MONGODB_URI=mongodb://healthmitra_app:YOUR_APP_PASSWORD@mongo:27017/healthmitra?authSource=admin
# For MongoDB Atlas (recommended):
# MONGODB_URI=mongodb+srv://healthmitra_app:YOUR_APP_PASSWORD@cluster0.xxxxx.mongodb.net/healthmitra?retryWrites=true&w=majority
MONGODB_DB_NAME=healthmitra

# --- Third-party APIs ---
GROQ_API_KEY=your_production_groq_api_key

# --- Swagger Docs (disabled by default in production) ---
# DOCS_ENABLED=false
